# AI-Medicine deployment — copy to .env and adjust
# Used by: Docker Compose, and by frontend (Vite) when building locally

# Backend (api.py)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Frontend build (only for local npm run build; Docker uses build-arg)
# When served from same origin as API, use /api
VITE_API_URL=/api

# Optional: port (Docker default 8000)
# PORT=8000
