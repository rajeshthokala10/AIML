# Copy this file to .env and fill in the values

# ---- LLM provider (OpenAI by default) -------------------------------------
OPENAI_API_KEY=sk-...

# ---- LangSmith tracing (optional but recommended) -------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls_...
LANGCHAIN_PROJECT=GraphRAG-KG
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- Qdrant ---------------------------------------------------------------
# Leave unset for the in-process default (uses ":memory:" from config.yaml).
# `docker compose up` overrides this automatically to point at the qdrant
# service. For a self-managed Qdrant on the host, uncomment:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
